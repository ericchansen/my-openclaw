{
  "browser": {
    "enabled": true,
    "allowSystemProfileImport": false,
    "evaluateEnabled": false,
    "headless": true,
    "noSandbox": false,
    "attachOnly": false,
    "defaultProfile": "openclaw",
    "snapshotDefaults": {
      "mode": "efficient"
    },
    "tabCleanup": {
      "enabled": true
    },
    "extensionRelay": {
      "allowLegacyAuth": false
    },
    "ssrfPolicy": {
      "dangerouslyAllowPrivateNetwork": false,
      "allowRfc2544BenchmarkRange": false,
      "allowIpv6UniqueLocalRange": false,
      "allowedHostnames": [],
      "blockedHostnames": []
    }
  },
  "update": {
    "channel": "stable",
    "auto": {
      "enabled": false
    }
  },
  "secrets": {
    "providers": {
      "azure-key-vault": {
        "source": "exec",
        "command": "/usr/local/bin/openclaw-keyvault-resolver",
        "args": [
          "--vault-name",
          "YOUR_KEY_VAULT_NAME"
        ],
        "timeoutMs": 10000,
        "noOutputTimeoutMs": 5000,
        "maxOutputBytes": 65536,
        "jsonOnly": true,
        "trustedDirs": [
          "/usr/local/bin"
        ]
      }
    },
    "defaults": {
      "exec": "azure-key-vault"
    }
  },
  "security": {
    "installPolicy": {
      "enabled": true,
      "targets": [
        "skill",
        "plugin"
      ],
      "exec": {
        "source": "exec",
        "command": "/usr/local/bin/openclaw-install-policy",
        "timeoutMs": 5000,
        "noOutputTimeoutMs": 2000,
        "maxOutputBytes": 16384,
        "passEnv": [],
        "trustedDirs": [
          "/usr/local/bin"
        ]
      }
    }
  },
  "auth": {
    "profiles": {
      "github-copilot:github": {
        "provider": "github-copilot",
        "mode": "token"
      }
    }
  },
  "agents": {
    "ownership": "explicit",
    "defaults": {
      "model": {
        "primary": "github-copilot/claude-sonnet-5",
        "fallbacks": [
          "github-copilot/gpt-5.6-sol"
        ]
      },
      "thinkingDefault": "high",
      "utilityModel": "github-copilot/gpt-5.6-luna",
      "models": {
        "github-copilot/claude-opus-4.6": {
          "alias": "previous-primary-opus"
        },
        "github-copilot/claude-sonnet-4.6": {
          "alias": "fallback-sonnet"
        },
        "github-copilot/gemini-2.5-pro": {
          "alias": "fallback-gemini"
        },
        "github-copilot/claude-opus-4.8": {
          "alias": "benchmark-opus-4-8"
        },
        "github-copilot/claude-sonnet-5": {
          "alias": "fallback-sonnet-5"
        },
        "github-copilot/gpt-5.6-sol": {
          "alias": "primary-sol",
          "params": {
            "thinking": "high"
          }
        },
        "github-copilot/gpt-5.6-luna": {
          "alias": "utility-luna",
          "params": {
            "thinking": "low"
          }
        }
      },
      "workspace": "/home/azureuser/.openclaw/workspace",
      "verboseDefault": "on",
      "maxConcurrent": 2,
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "1h",
        "hardClear": {
          "enabled": true
        }
      },
      "subagents": {
        "delegationMode": "prefer",
        "maxConcurrent": 2,
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 3,
        "model": "github-copilot/gpt-5.6-luna",
        "thinking": "low",
        "runTimeoutSeconds": 2700
      },
      "heartbeat": {
        "every": "2h",
        "model": "github-copilot/gpt-5.6-sol",
        "lightContext": true,
        "isolatedSession": true
      },
      "sandbox": {
        "mode": "non-main",
        "backend": "docker",
        "scope": "session",
        "workspaceAccess": "rw",
        "sessionToolsVisibility": "spawned",
        "docker": {
          "image": "openclaw-sandbox:bookworm-slim",
          "readOnlyRoot": true,
          "tmpfs": [
            "/tmp:rw,nosuid,nodev,noexec,size=128m",
            "/var/tmp:rw,nosuid,nodev,noexec,size=64m",
            "/run:rw,nosuid,nodev,size=16m"
          ],
          "network": "none",
          "user": "1000:1000",
          "capDrop": [
            "ALL"
          ],
          "pidsLimit": 256,
          "memory": "1g",
          "memorySwap": "1g",
          "cpus": 1,
          "ulimits": {
            "nofile": "1024:2048"
          }
        },
        "browser": {
          "enabled": true,
          "network": "openclaw-sandbox-browser",
          "headless": true,
          "noVncEnabled": false,
          "allowHostControl": false,
          "autoStart": false,
          "autoStartTimeoutMs": 12000,
          "binds": []
        },
        "prune": {
          "idleHours": 1,
          "maxAgeDays": 7
        }
      }
    },
    "entries": {
      "healthcheck": {
        "workspace": "/home/azureuser/.openclaw/workspace-healthcheck",
        "heartbeat": { "every": "0m" },
        "sandbox": {
          "mode": "all",
          "scope": "agent",
          "workspaceAccess": "none",
          "browser": { "enabled": false }
        },
        "memory": { "search": { "enabled": false } },
        "tools": {
          "allow": ["exec"],
          "elevated": { "enabled": false },
          "fs": { "workspaceOnly": true }
        }
      },
      "main": {
        "identity": {
          "name": "YOUR_AGENT_NAME",
          "emoji": "🤖"
        },
        "sandbox": {
          "scope": "agent",
          "sessionToolsVisibility": "all"
        },
        "memory": {
          "search": {
            "rememberAcrossConversations": true,
            "sources": [
              "memory",
              "sessions"
            ],
            "experimental": {
              "sessionMemory": true
            }
          }
        }
      },
      "orchestrator": {
        "workspace": "/home/azureuser/.openclaw/workspace",
        "model": {
          "primary": "github-copilot/claude-sonnet-5",
          "fallbacks": [
            "github-copilot/gpt-5.6-sol"
          ]
        },
        "thinkingDefault": "high",
        "identity": {
          "name": "Orchestrator",
          "emoji": "🎯"
        },
        "sandbox": {
          "scope": "agent",
          "mode": "all"
        },
        "memory": {
          "search": {
            "rememberAcrossConversations": false,
            "sources": [
              "memory"
            ]
          }
        },
        "tools": {
          "elevated": {
            "enabled": false
          },
          "fs": {
            "workspaceOnly": true
          }
        }
      }
    }
  },
  "bindings": [
    {
      "agentId": "main",
      "match": {
        "channel": "telegram"
      }
    },
    {
      "agentId": "main",
      "match": {
        "channel": "discord"
      }
    }
  ],
  "memory": {
    "citations": "auto",
    "search": {
      "enabled": true,
      "rememberAcrossConversations": false,
      "sources": [
        "memory"
      ],
      "provider": "github-copilot",
      "model": "text-embedding-3-small",
      "store": {
        "fts": {
          "tokenizer": "unicode61"
        },
        "vector": {
          "enabled": true
        }
      },
      "query": {
        "maxResults": 6,
        "minScore": 0.35
      },
      "cache": {
        "enabled": true
      }
    }
  },
  "mcp": {
    "servers": {
      "ebird": {
        "command": "/usr/local/bin/openclaw-mcp-launch",
        "connectionTimeoutMs": 30000,
        "requestTimeoutMs": 60000,
        "args": [
          "ebird"
        ]
      },
      "pondlog": {
        "command": "/usr/local/bin/openclaw-mcp-launch",
        "connectionTimeoutMs": 30000,
        "requestTimeoutMs": 60000,
        "args": [
          "pondlog"
        ]
      }
    }
  },
  "tools": {
    "profile": "coding",
    "alsoAllow": [
      "group:web",
      "browser",
      "message"
    ],
    "web": {
      "search": {
        "enabled": true,
        "provider": "brave"
      },
      "fetch": {
        "enabled": true,
        "maxChars": 12000,
        "maxCharsCap": 20000,
        "maxResponseBytes": 750000,
        "timeoutSeconds": 20,
        "cacheTtlMinutes": 15,
        "maxRedirects": 3,
        "readability": true,
        "useTrustedEnvProxy": false,
        "ssrfPolicy": {
          "dangerouslyAllowPrivateNetwork": false,
          "allowRfc2544BenchmarkRange": false,
          "allowIpv6UniqueLocalRange": false,
          "allowedHostnames": [],
          "blockedHostnames": []
        }
      }
    },
    "exec": {
      "host": "auto",
      "mode": "ask",
      "strictInlineEval": true,
      "commandHighlighting": true,
      "timeoutSeconds": 1800,
      "approvalRunningNoticeMs": 10000,
      "cleanupMs": 1800000,
      "notifyOnExit": true,
      "notifyOnExitEmptySuccess": false
    },
    "fs": {
      "workspaceOnly": false
    },
    "elevated": {
      "enabled": true,
      "allowFrom": {
        "telegram": [
          "YOUR_TELEGRAM_USER_ID"
        ],
        "discord": [
          "YOUR_DISCORD_USER_ID"
        ]
      }
    },
    "agentToAgent": {
      "enabled": true,
      "allow": [
        "main",
        "orchestrator"
      ]
    },
    "updatePlan": true,
    "toolSearch": {
      "enabled": false,
      "mode": "directory",
      "searchDefaultLimit": 8,
      "maxSearchLimit": 20
    },
    "sessions": {
      "visibility": "tree"
    },
    "subagents": {
      "tools": {
        "deny": [
          "gateway",
          "nodes"
        ]
      }
    },
    "sandbox": {
      "tools": {
        "alsoAllow": [
          "web_search",
          "web_fetch",
          "browser",
          "memory_search",
          "memory_get",
          "bundle-mcp"
        ],
        "deny": [
          "gateway",
          "nodes"
        ]
      }
    }
  },
  "approvals": {
    "exec": {
      "enabled": true,
      "mode": "session",
      "agentFilter": [
        "main"
      ],
      "targets": []
    },
    "plugin": {
      "enabled": false,
      "mode": "session",
      "targets": []
    }
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "ownerAllowFrom": [
      "telegram:YOUR_TELEGRAM_USER_ID",
      "discord:YOUR_DISCORD_USER_ID"
    ]
  },
  "session": {
    "scope": "per-sender",
    "dmScope": "per-channel-peer",
    "groupScope": "per-group",
    "sharing": {
      "readOnly": false,
      "suggest": false,
      "drafts": true
    },
    "identityLinks": {
      "YOUR_USERNAME": [
        "telegram:YOUR_TELEGRAM_USER_ID",
        "discord:YOUR_DISCORD_USER_ID"
      ]
    }
  },
  "cron": {
    "enabled": true,
    "skipMissedJobs": true,
    "sessionRetention": "24h",
    "failureAlert": {
      "enabled": true,
      "after": 2,
      "cooldownMs": 3600000,
      "includeSkipped": false,
      "mode": "announce"
    }
  },
  "channels": {
    "telegram": {
      "dmPolicy": "allowlist",
      "botToken": {
        "source": "exec",
        "provider": "azure-key-vault",
        "id": "TELEGRAM-BOT-TOKEN"
      },
      "allowFrom": [
        "YOUR_TELEGRAM_USER_ID"
      ],
      "groupPolicy": "disabled",
      "streaming": {
        "mode": "partial"
      }
    },
    "discord": {
      "enabled": true,
      "token": {
        "source": "exec",
        "provider": "azure-key-vault",
        "id": "DISCORD-BOT-TOKEN"
      },
      "groupPolicy": "allowlist",
      "dmPolicy": "allowlist",
      "allowFrom": [
        "YOUR_DISCORD_USER_ID"
      ],
      "dm": {
        "enabled": true
      },
      "guilds": {
        "YOUR_GUILD_ID": {
          "requireMention": true,
          "toolsBySender": {
            "YOUR_DISCORD_USER_ID": {
              "allow": ["*"]
            },
            "*": {
              "deny": ["exec", "write", "edit", "gateway", "cron"]
            }
          },
          "users": ["YOUR_DISCORD_USER_ID"],
          "channels": {
            "YOUR_AGENT_CHANNEL_ID": {
              "requireMention": false
            },
            "*": {}
          }
        }
      }
    }
  },
  "gateway": {
    "mode": "local",
    "controlUi": {
      "enabled": true,
      "environment": {
        "label": "production",
        "color": "red"
      },
      "sessionObserver": true,
      "embedSandbox": "strict",
      "allowExternalEmbedUrls": false,
      "automaticallyFetchFavicons": false,
      "dangerouslyAllowHostHeaderOriginFallback": false
    },
    "auth": {
      "mode": "token",
      "token": {
        "source": "exec",
        "provider": "azure-key-vault",
        "id": "OPENCLAW-GATEWAY-TOKEN"
      },
      "allowTailscale": true
    },
    "tailscale": {
      "mode": "serve"
    }
  },
  "plugins": {
    "allow": [
      "active-memory",
      "brave",
      "browser",
      "device-pair",
      "diagnostics-otel",
      "discord",
      "github-copilot",
      "memory-core",
      "memory-wiki",
      "telegram"
    ],
    "slots": {
      "memory": "memory-core"
    },
    "entries": {
      "diagnostics-otel": {
        "enabled": true
      },
      "active-memory": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true,
          "timeoutMs": 20000
        },
        "subagent": {
          "allowModelOverride": true,
          "allowedModels": [
            "github-copilot/gpt-5.6-luna",
            "github-copilot/claude-sonnet-5"
          ]
        },
        "config": {
          "enabled": true,
          "mode": "escalate",
          "agents": [
            "main"
          ],
          "model": "github-copilot/gpt-5.6-luna",
          "modelFallback": "github-copilot/claude-sonnet-5",
          "allowedChatTypes": [
            "direct",
            "explicit"
          ],
          "thinking": "low",
          "fastMode": true,
          "timeoutMs": 15000,
          "setupGraceTimeoutMs": 1500,
          "queryMode": "recent",
          "promptStyle": "balanced",
          "toolsAllow": [
            "memory_search",
            "memory_get"
          ],
          "maxSummaryChars": 220,
          "recentUserTurns": 4,
          "recentAssistantTurns": 2,
          "recentUserChars": 1000,
          "recentAssistantChars": 800,
          "logging": true,
          "persistTranscripts": false,
          "cacheTtlMs": 30000,
          "circuitBreakerMaxTimeouts": 3,
          "circuitBreakerCooldownMs": 60000
        }
      },
      "brave": {
        "enabled": true,
        "config": {
          "webSearch": {
            "apiKey": {
              "source": "exec",
              "provider": "azure-key-vault",
              "id": "BRAVE-API-KEY"
            }
          }
        }
      },
      "discord": {
        "enabled": true
      },
      "device-pair": {
        "enabled": true
      },
      "browser": {
        "enabled": true
      },
      "github-copilot": {
        "enabled": true
      },
      "memory-core": {
        "enabled": true,
        "subagent": {
          "allowModelOverride": true,
          "allowedModels": [
            "github-copilot/gpt-5.6-luna"
          ]
        },
        "config": {
          "memoryPolicy": {
            "excludeSessions": {
              "hookExternalContentSources": [
                "email",
                "gmail",
                "webhook"
              ],
              "channels": [],
              "chatTypes": [
                "group",
                "channel"
              ]
            }
          },
          "dreaming": {
            "enabled": true,
            "frequency": "0 3 * * *",
            "model": "github-copilot/gpt-5.6-luna",
            "timezone": "UTC",
            "verboseLogging": false,
            "storage": {
              "mode": "both",
              "separateReports": true
            },
            "execution": {
              "defaults": {
                "model": "github-copilot/gpt-5.6-luna"
              }
            },
            "phases": {
              "light": {
                "enabled": true,
                "lookbackDays": 7,
                "limit": 100,
                "dedupeSimilarity": 0.9,
                "execution": {
                  "model": "github-copilot/gpt-5.6-luna"
                }
              },
              "rem": {
                "enabled": true,
                "lookbackDays": 30,
                "limit": 50,
                "minPatternStrength": 0.65,
                "execution": {
                  "model": "github-copilot/gpt-5.6-luna"
                }
              },
              "deep": {
                "enabled": true,
                "limit": 20,
                "minScore": 0.75,
                "minRecallCount": 3,
                "minUniqueQueries": 3,
                "recencyHalfLifeDays": 14,
                "maxAgeDays": 90,
                "maxPromotedSnippetTokens": 160,
                "maxPriorEntryLossFraction": 0.1,
                "execution": {
                  "model": "github-copilot/gpt-5.6-luna"
                }
              }
            }
          }
        }
      },
      "memory-wiki": {
        "enabled": true,
        "config": {
          "vaultMode": "bridge",
          "vault": {
            "scope": "agent",
            "path": "/home/azureuser/.openclaw/wiki",
            "renderMode": "native"
          },
          "obsidian": {
            "enabled": false,
            "useOfficialCli": false,
            "openAfterWrites": false
          },
          "bridge": {
            "enabled": true,
            "readMemoryArtifacts": true,
            "indexDreamReports": true,
            "indexDailyNotes": true,
            "indexMemoryRoot": true,
            "followMemoryEvents": true
          },
          "unsafeLocal": {
            "allowPrivateMemoryCoreAccess": false,
            "paths": []
          },
          "ingest": {
            "autoCompile": true,
            "maxConcurrentJobs": 1,
            "allowUrlIngest": false
          },
          "search": {
            "backend": "shared",
            "corpus": "all"
          },
          "context": {
            "includeCompiledDigestPrompt": false
          },
          "render": {
            "preserveHumanBlocks": true,
            "createBacklinks": true,
            "createDashboards": true
          }
        }
      },
      "telegram": {
        "enabled": true
      }
    }
  },
  "diagnostics": {
    "enabled": true,
    "otel": {
      "enabled": true,
      "endpoint": "http://127.0.0.1:4318",
      "tracesEndpoint": "http://127.0.0.1:4318/v1/traces",
      "metricsEndpoint": "http://127.0.0.1:4318/v1/metrics",
      "logsEndpoint": "http://127.0.0.1:4318/v1/logs",
      "protocol": "http/protobuf",
      "serviceName": "openclaw-gateway",
      "traces": true,
      "metrics": true,
      "logs": true,
      "logsExporter": "otlp",
      "sampleRate": 1.0,
      "flushIntervalMs": 30000,
      "captureContent": false
    }
  },
  "logging": {
    "level": "info",
    "file": "/var/log/openclaw/openclaw.log",
    "maxFileBytes": 104857600,
    "consoleLevel": "info",
    "consoleStyle": "json",
    "audit": {
      "enabled": true,
      "executionIdentity": true,
      "messages": "off"
    }
  }
}
