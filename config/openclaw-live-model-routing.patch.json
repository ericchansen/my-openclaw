{
  "agents": {
    "defaults": {
      "model": {
        "primary": "github-copilot/gpt-5.6-sol-fast",
        "fallbacks": [
          "github-copilot/claude-opus-5"
        ]
      },
      "thinkingDefault": "xhigh",
      "models": {
        "github-copilot/gpt-5.6-sol-fast": {
          "alias": "primary-sol-fast",
          "params": {
            "thinking": "xhigh"
          }
        },
        "github-copilot/claude-opus-5": {
          "alias": "fallback-opus-5",
          "params": {
            "thinking": "xhigh"
          }
        },
        "github-copilot/gpt-6-astra": {
          "alias": "astra",
          "agentRuntime": {
            "id": "copilot"
          }
        }
      }
    },
    "entries": {
      "orchestrator": {
        "model": {
          "primary": "github-copilot/gpt-6-astra",
          "fallbacks": [
            "github-copilot/gpt-5.6-sol-fast"
          ]
        }
      },
      "fitness": {
        "model": {
          "primary": "github-copilot/gpt-5.6-sol-fast",
          "fallbacks": [
            "github-copilot/claude-opus-5"
          ]
        }
      }
    }
  }
}
