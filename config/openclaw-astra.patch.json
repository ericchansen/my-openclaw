{
  "agents": {
    "defaults": {
      "models": {
        "github-copilot/gpt-6-astra": {
          "alias": "astra",
          "agentRuntime": {
            "id": "copilot"
          }
        }
      }
    },
    "entries": {
      "orchestrator": {
        "model": {
          "primary": "github-copilot/gpt-6-astra",
          "fallbacks": [
            "github-copilot/gpt-5.6-sol-fast"
          ]
        }
      }
    }
  },
  "plugins": {
    "entries": {
      "copilot": {
        "enabled": true
      }
    }
  }
}
